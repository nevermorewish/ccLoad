# Golden requests preserve raw JSON whitespace; keep fixtures stable on Windows.
internal/protocol/cliproxy/claude/openai/responses/testdata/tool_search_disabled/*.json text eol=lf
.agents/skills/sync-cliproxy-core/references/*.manifest text eol=lf

# Generated bundles contain whitespace inside vendored template strings.
web/assets/bundles/* -whitespace

*.go text eol=lf

# SSE framing fixtures must not acquire CRLF during Windows checkout.
internal/app/testdata/*.txt text eol=lf

# Shell scripts run inside Alpine/Debian images; CRLF breaks their shebang.
*.sh text eol=lf
third_party/cursor-sdk-bridge/bridge.lock text eol=lf
